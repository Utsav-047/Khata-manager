# Khata Management System - Production Environment Configuration Template
# Copy this file to .env and populate with secure random credentials

# Application Environment
APP_ENV=production

# Database Configuration (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=khata_admin
DB_PASSWORD=YourStrongDatabasePassword2026!
DB_NAME=khata_management

# Security & Cryptography
# Generate a secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_secure_random_64_character_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Whitelist (Comma-separated exact domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Business Defaults
BUSINESS_NAME=Kisan Krishi Seva Kendra
BUSINESS_CURRENCY_SYMBOL=₹
BUSINESS_TIMEZONE=Asia/Kolkata

