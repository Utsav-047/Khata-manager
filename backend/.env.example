# ─────────────────────────────────────────────
# Khata Management System – Backend Environment
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database (XAMPP MariaDB on port 3307) ────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=khata_management

# ── Security ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_64_char_random_hex_string_here_000000000000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App Settings ──────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Business ──────────────────────────────────
BUSINESS_NAME=My Shop
BUSINESS_CURRENCY_SYMBOL=₹
BUSINESS_TIMEZONE=Asia/Kolkata
