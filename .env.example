# ─────────────────────────────────────────────
# Khata Management System – Environment Template
# ─────────────────────────────────────────────
# Backend is powered by Python FastAPI + MariaDB / MySQL

# Database (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=khata_management

# Security
SECRET_KEY=change_me_generate_a_64_char_random_hex_string_here_000000000000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App Settings
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business Settings
BUSINESS_NAME=My Shop
BUSINESS_CURRENCY_SYMBOL=₹
BUSINESS_TIMEZONE=Asia/Kolkata
